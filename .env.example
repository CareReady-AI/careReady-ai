# CareReady AI - Frontend Environment Configuration
# FastAPI Backend URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth Configuration (Public Anonymous credentials only, NEVER service role key)
VITE_SUPABASE_URL=
